<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Feasibility report: {{ scenario.name }}</title>
<style>
  body { font-family: -apple-system, Segoe UI, Helvetica, Arial, sans-serif; color: #1a1a1a;
         max-width: 900px; margin: 2rem auto; padding: 0 1rem; line-height: 1.5; }
  h1 { font-size: 1.6rem; margin-bottom: 0.2rem; }
  h2 { font-size: 1.15rem; margin-top: 2.2rem; border-bottom: 1px solid #ddd; padding-bottom: 0.3rem; }
  .subtitle { color: #666; margin-top: 0; }
  .verdict { display: inline-block; padding: 0.6rem 1.2rem; border-radius: 6px; color: white;
             font-weight: bold; font-size: 1.1rem; background: {{ verdict_color }}; }
  table { border-collapse: collapse; width: 100%; margin: 0.8rem 0; }
  th, td { text-align: left; padding: 0.35rem 0.6rem; border-bottom: 1px solid #eee; font-size: 0.92rem; }
  th { color: #444; font-weight: 600; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  .pass { color: #1e7e34; font-weight: 600; }
  .fail { color: #b22222; font-weight: 600; }
  .issues li { margin-bottom: 0.4rem; }
  img { max-width: 100%; }
  .meta { color: #666; font-size: 0.85rem; }
</style>
</head>
<body>

<h1>Feasibility report: {{ scenario.name }}</h1>
<p class="subtitle">ios-mission-planner, feasibility screening pipeline</p>

<p><span class="verdict">{{ result.verdict }}</span></p>

{% if result.issues %}
<ul class="issues">
  {% for issue in result.issues %}
  <li>{{ issue }}</li>
  {% endfor %}
</ul>
{% else %}
<p>No issues flagged against the configured thresholds.</p>
{% endif %}

<h2>Mission assumptions</h2>
<table>
  <tr><th>Chief altitude</th><td class="num">{{ "%.1f"|format(scenario.chief.altitude_km) }} km</td></tr>
  <tr><th>Chief inclination</th><td class="num">{{ "%.1f"|format(scenario.chief.inclination_deg) }} deg</td></tr>
  <tr><th>Deputy parking altitude</th><td class="num">{{ "%.1f"|format(scenario.deputy.parking_altitude_km) }} km</td></tr>
  <tr><th>Deputy dry mass</th><td class="num">{{ "%.1f"|format(scenario.deputy.dry_mass_kg) }} kg</td></tr>
  <tr><th>Specific impulse</th><td class="num">{{ "%.0f"|format(scenario.deputy.propulsion.isp_s) }} s</td></tr>
  <tr><th>Safety ellipse radius</th><td class="num">{{ "%.0f"|format(scenario.safety_ellipse.radius_m) }} m</td></tr>
  <tr><th>Station-keeping dwell</th><td class="num">{{ "%.1f"|format(scenario.station_keeping.dwell_days) }} days</td></tr>
  <tr><th>Deorbit target perigee altitude</th><td class="num">{{ "%.0f"|format(scenario.disposal.target_perigee_altitude_km) }} km</td></tr>
  <tr><th>Plane-change contingency</th><td class="num">{{ "%.1f"|format(scenario.plane_change_deg) }} deg</td></tr>
</table>

<h2>Delta-v budget</h2>
<img src="data:image/png;base64,{{ budget_figure }}" alt="Delta-v budget chart">
<table>
  <tr><th>Phase</th><th>Maturity margin</th><th>Nominal [m/s]</th><th>Margined [m/s]</th></tr>
  {% for line in result.budget_lines %}
  <tr>
    <td>{{ line.label }}</td>
    <td class="num">{{ "%.0f"|format(line.margin * 100) }}%</td>
    <td class="num">{{ "%.3f"|format(line.delta_v) }}</td>
    <td class="num">{{ "%.3f"|format(line.margined_delta_v) }}</td>
  </tr>
  {% endfor %}
  <tr><th>Total, with {{ "%.0f"|format(scenario.margins.system_reserve * 100) }}% system reserve</th>
      <th></th><th></th><td class="num"><b>{{ "%.3f"|format(result.delta_v_total) }}</b></td></tr>
</table>

<h2>Propellant and mass</h2>
<table>
  <tr><th>Total delta-v</th><td class="num">{{ "%.3f"|format(result.delta_v_total) }} m/s</td></tr>
  <tr><th>Propellant mass</th><td class="num">{{ "%.4f"|format(result.propellant_mass_kg) }} kg</td></tr>
  <tr><th>Wet mass</th><td class="num">{{ "%.2f"|format(result.wet_mass_kg) }} kg</td></tr>
  <tr><th>Wet mass budget</th><td class="num">{{ "%.1f"|format(scenario.verdict_thresholds.max_wet_mass_kg) }} kg</td></tr>
</table>

<h2>Far-range approach trajectory</h2>
<img src="data:image/png;base64,{{ trajectory_figure }}" alt="Far-range approach trajectory">

<h2>Safety checks</h2>
<table>
  <tr><th>Check</th><th>Result</th><th>Margin</th></tr>
  {% for check in result.safety_checks %}
  <tr>
    <td>{{ check.label }}</td>
    <td class="{{ 'pass' if check.passed else 'fail' }}">{{ 'PASS' if check.passed else 'FAIL' }}</td>
    <td class="num">{{ "%.4f"|format(check.margin) }} {{ check.margin_unit }}</td>
  </tr>
  {% endfor %}
  <tr>
    <td>Monte Carlo collision probability</td>
    <td class="{{ 'pass' if result.collision_probability <= scenario.verdict_thresholds.max_collision_probability else 'fail' }}">
      {{ 'PASS' if result.collision_probability <= scenario.verdict_thresholds.max_collision_probability else 'FAIL' }}
    </td>
    <td class="num">{{ "%.3f%%"|format(result.collision_probability * 100) }}</td>
  </tr>
</table>

<p class="meta">Generated by ios-mission-planner's feasibility screening pipeline. Every number above
comes from closed-form methods (Hohmann transfers, Clohessy-Wiltshire targeting, the rocket equation)
documented in the project's theory book, not from a fresh nonlinear re-flight of the mission.</p>

</body>
</html>
